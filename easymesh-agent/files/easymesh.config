config agent 'agent'
	option enabled '1'
	# bridge the agent speaks IEEE 1905 on (backhaul STA and LAN ports are members)
	option interface 'br-lan'
	# 1905 AL MAC; empty = MAC of the interface above
	option al_mac ''
	# wireless section of the backhaul STA (created by easymesh-pair if missing)
	option bsta 'em_bsta'
	option network 'lan'
	# pair only with this controller BSSID (empty = any controller in WPS mode)
	option controller_bssid ''
	# move radios to the channels the controller selects / the backhaul uses
	option follow_channels '1'
	option name 'OpenWrt EasyMesh agent'
	# model shown by the controller (empty = /tmp/sysinfo/model)
	option model ''
	option quiet '1'
