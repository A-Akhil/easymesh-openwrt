#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
# EasyMesh agent (ucode): joins an EasyMesh controller; settings in /etc/config/easymesh.
START=99
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/ucode /usr/share/easymesh/agent.uc --config
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger easymesh
}
